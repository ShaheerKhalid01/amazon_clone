{
  "name": "amazon-clone",
  "version": "1.0.0",
  "private": true,
  "description": "Full-featured Amazon Clone with NestJS and React",
  "author": "Amazon Clone Team",
  "license": "MIT",
  "scripts": {
    "setup": "npm install && npm --prefix backend install && npm --prefix frontend install --include=dev",
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm run setup && npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start:prod": "npm --prefix backend run start:prod",
    "lint": "npm --prefix backend run lint && npm --prefix frontend run lint",
    "test": "npm --prefix backend run test && npm --prefix frontend run test",
    "test:backend": "npm --prefix backend run test",
    "test:frontend": "npm --prefix frontend run test",
    "test:e2e": "npm --prefix backend run test:e2e",
    "clean": "rimraf backend/node_modules frontend/node_modules node_modules",
    "reinstall": "npm run clean && npm run setup",
    "seed": "npm --prefix backend run seed",
    "migrate": "npm --prefix backend run migration:run",
    "docker:dev": "docker-compose up -d",
    "docker:build": "docker-compose build",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v && docker system prune -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.7",
    "react-redux": "^8.1.3"
  }
}
